# Firemní záložna — konfigurace serveru
PORT=3000

# Doručení leadů: "webhook" (výchozí) nebo "smtp"
LEAD_DELIVERY=webhook

# --- webhook (LEAD_DELIVERY=webhook) ---
# Centrální lead-service skupiny CFG; payload: { source, type, lead }
FORM_API_URL=https://example.com/api/leads

# --- smtp / Amazon SES (LEAD_DELIVERY=smtp) ---
SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=web@firemnizalozna.cz
LEAD_EMAIL_TO=
